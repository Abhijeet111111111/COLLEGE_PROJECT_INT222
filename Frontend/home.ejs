<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Tourism Platform</title>
    <link rel="stylesheet" href="home.css" />
    <link rel="stylesheet" href="/nav-auth.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- ════════════════════════════════════════════════════════════
     HOTEL DETAIL DIALOG
════════════════════════════════════════════════════════════ -->

<!-- ── Hotel detail dialog ──────────────────────────────────── -->
<div class="hd-backdrop" id="hd-backdrop" style="display:none" role="dialog" aria-modal="true" aria-labelledby="hd-name">

  <div class="hd-dialog" id="hd-dialog">

    <!-- Loading skeleton shown while fetching -->
    <div class="hd-skeleton" id="hd-skeleton">
      <div class="sk-thumb"></div>
      <div class="sk-body">
        <div class="sk-line sk-w60"></div>
        <div class="sk-line sk-w40"></div>
        <div class="sk-line sk-w80"></div>
        <div class="sk-line sk-w50"></div>
      </div>
    </div>

    <!-- Actual content (hidden until loaded) -->
    <div class="hd-content" id="hd-content" style="display:none">

      <!-- Step pills -->
      <div class="hd-steps">
        <div class="hd-step active" id="hd-step-pill-1">
          <span class="hd-step-num">1</span><span class="hd-step-lbl">Hotel details</span>
        </div>
        <div class="hd-step-bar"></div>
        <div class="hd-step" id="hd-step-pill-2">
          <span class="hd-step-num">2</span><span class="hd-step-lbl">Your details</span>
        </div>
        <div class="hd-step-bar"></div>
        <div class="hd-step" id="hd-step-pill-3">
          <span class="hd-step-num">3</span><span class="hd-step-lbl">Payment</span>
        </div>
      </div>

      <!-- ── STEP 1 : Hotel detail view ─────────────────────── -->
      <div id="hd-step-1">

        <!-- Thumb -->
        <div class="hd-thumb" id="hd-thumb"></div>

        <!-- Close btn -->
        <button class="hd-close" id="hd-close" aria-label="Close">&#10005;</button>

        <!-- Badges on thumb -->
        <div class="hd-thumb-badges" id="hd-thumb-badges"></div>

        <!-- Info body -->
        <div class="hd-body">

          <div class="hd-title-row">
            <div>
              <h2 class="hd-name" id="hd-name"></h2>
              <div class="hd-loc"  id="hd-loc"></div>
            </div>
            <div class="hd-rating-block">
              <div class="hd-rating" id="hd-rating"></div>
              <div class="hd-reviews" id="hd-reviews"></div>
            </div>
          </div>

          <p class="hd-desc" id="hd-desc"></p>

          <!-- Quick stats row -->
          <div class="hd-stats" id="hd-stats"></div>

          <!-- Tags -->
          <div class="hd-section-label">Tags</div>
          <div class="hd-tags" id="hd-tags"></div>

          <!-- Amenities -->
          <div class="hd-section-label">Amenities</div>
          <div class="hd-amenities" id="hd-amenities"></div>

          <!-- Eco score -->
          <div class="hd-section-label">Eco score</div>
          <div class="hd-eco-row" id="hd-eco-row"></div>

          <!-- Footer -->
          <div class="hd-footer">
            <div>
              <div class="hd-price" id="hd-price"></div>
              <div class="hd-price-sub" id="hd-price-sub"></div>
            </div>
            <button class="hd-btn-book" id="hd-btn-book">Book Now</button>
          </div>

        </div>
      </div><!-- /step-1 -->

      <!-- ── STEP 2 : Guest details form ───────────────────── -->
      <div id="hd-step-2" style="display:none">

        <div class="hd-form-header">
          <div>
            <div class="hd-form-title" id="hd-form-hotel-name"></div>
            <div class="hd-form-sub"   id="hd-form-hotel-sub"></div>
          </div>
          <button class="hd-close hd-close-abs" id="hd-close-2">&#10005;</button>
        </div>

        <div class="hd-form-grid">
          <div class="hd-field">
            <label class="hd-label">Full name <span class="req">*</span></label>
            <input id="hg-name"    class="hd-input" type="text"   placeholder="e.g. Priya Sharma"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">Email address <span class="req">*</span></label>
            <input id="hg-email"   class="hd-input" type="email"  placeholder="you@example.com"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">Phone number <span class="req">*</span></label>
            <input id="hg-phone"   class="hd-input" type="tel"    placeholder="+91 98765 43210"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">Guests <span class="req">*</span></label>
            <select id="hg-guests" class="hd-input">
              <option value="">Select</option>
              <option value="1">1 guest</option>
              <option value="2">2 guests</option>
              <option value="3">3 guests</option>
              <option value="4">4 guests</option>
              <option value="5+">5+ guests</option>
            </select>
          </div>
          <div class="hd-field">
            <label class="hd-label">Check-in date <span class="req">*</span></label>
            <input id="hg-checkin"  class="hd-input" type="date"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">Check-out date <span class="req">*</span></label>
            <input id="hg-checkout" class="hd-input" type="date"/>
          </div>
          <div class="hd-field hd-field-full">
            <label class="hd-label">Special requests <span class="hd-optional">(optional)</span></label>
            <textarea id="hg-requests" class="hd-input hd-textarea" placeholder="Dietary needs, room preferences, early check-in..."></textarea>
          </div>
        </div>

        <div class="hd-form-footer">
          <button class="hd-btn-back" id="hd-back-1">&#8592; Back</button>
          <div class="hd-total-preview" id="hd-total-preview">Total: &#8377;4,200</div>
          <button class="hd-btn-next" id="hd-next-2">Next &#8594;</button>
        </div>
      </div><!-- /step-2 -->

      <!-- ── STEP 3 : Payment form ─────────────────────────── -->
      <div id="hd-step-3" style="display:none">

        <div class="hd-form-header">
          <div>
            <div class="hd-form-title">Payment details</div>
            <div class="hd-form-sub" id="hd-pay-summary"></div>
          </div>
          <button class="hd-close hd-close-abs" id="hd-close-3">&#10005;</button>
        </div>

        <!-- Method tabs -->
        <div class="hd-pay-tabs">
          <button class="hd-pay-tab active" data-method="card">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
              <rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/>
              <path d="M1 7h14" stroke="currentColor" stroke-width="1.3"/>
              <rect x="3" y="9.5" width="3" height="1.5" rx="0.5" fill="currentColor"/>
            </svg>
            Card
          </button>
          <button class="hd-pay-tab" data-method="upi">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
              <rect x="2" y="3" width="5" height="10" rx="1" stroke="currentColor" stroke-width="1.2"/>
              <rect x="9" y="3" width="5" height="10" rx="1" stroke="currentColor" stroke-width="1.2"/>
              <line x1="7" y1="5" x2="7" y2="11" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            UPI
          </button>
          <button class="hd-pay-tab" data-method="netbanking">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M8 4v8M4 8h8" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            Net Banking
          </button>
        </div>

        <!-- Card form -->
        <div id="hd-card-form" class="hd-pay-form hd-pay-form-grid">
          <div class="hd-field">
            <label class="hd-label">Cardholder name <span class="req">*</span></label>
            <input id="hp-name" class="hd-input" type="text" placeholder="As on card"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">Card number <span class="req">*</span></label>
            <input id="hp-num" class="hd-input" type="text" placeholder="1234  5678  9012  3456" maxlength="19"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">Expiry <span class="req">*</span></label>
            <input id="hp-expiry" class="hd-input" type="text" placeholder="MM / YY" maxlength="7"/>
          </div>
          <div class="hd-field">
            <label class="hd-label">CVV <span class="req">*</span></label>
            <input id="hp-cvv" class="hd-input" type="password" placeholder="•••" maxlength="4"/>
          </div>
        </div>

        <!-- UPI form -->
        <div id="hd-upi-form" class="hd-pay-form" style="display:none">
          <div class="hd-field">
            <label class="hd-label">UPI ID <span class="req">*</span></label>
            <input id="hp-upi" class="hd-input" type="email" placeholder="yourname@upi"/>
          </div>
        </div>

        <!-- Net banking form -->
        <div id="hd-net-form" class="hd-pay-form" style="display:none">
          <div class="hd-field">
            <label class="hd-label">Select bank <span class="req">*</span></label>
            <select id="hp-bank" class="hd-input">
              <option value="">Choose a bank</option>
              <option value="hdfc">HDFC Bank</option>
              <option value="icici">ICICI Bank</option>
              <option value="sbi">State Bank of India</option>
              <option value="axis">Axis Bank</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>

        <div class="hd-secure">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
            <path d="M8 1L2 4v4c0 4.5 6 6 6 6s6-1.5 6-6V4l-6-3z" stroke="currentColor" stroke-width="1" fill="none"/>
            <path d="M6 8l1.5 1.5L10 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Your payment is 100% secure & encrypted
        </div>

        <div class="hd-form-footer">
          <button class="hd-btn-back" id="hd-back-2">&#8592; Back</button>
          <button class="hd-btn-pay" id="hd-btn-pay">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <rect x="1" y="4" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M1 6.5h14" stroke="currentColor" stroke-width="1.3"/>
              <circle cx="11" cy="10.5" r="1.5" fill="currentColor"/>
            </svg>
            Confirm &amp; Pay
          </button>
        </div>
      </div><!-- /step-3 -->

    </div><!-- /hd-content -->
  </div><!-- /hd-dialog -->
</div><!-- /hd-backdrop -->

<!-- ════════════════════════════════════════════════════════════════
