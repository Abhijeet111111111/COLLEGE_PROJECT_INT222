<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="home.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <header>
      <div id="navbar">
        <h1 class="navbar-logo">
          <a style="text-decoration: none" href="/"
            ><span style="color: white">Wander</span
            ><span style="color: rgb(6, 187, 6)">Smart</span></a
          >
        </h1>
        <ul class="nav__items">
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/explore">Explore</a></li>
          <li class="nav__item">Hotels</li>
          <li class="nav__item">Tours</li>
          <li class="nav__item">Dashboard</li>
        </ul>
        <div class="nav__item-ctx">
          <button class="nav__item__ctx-button">Plan a Trip</button>
        </div>
      </div>
    </header>
    <main id="main">
      <dialog id="destinationDialog">
        
      </dialog>
      <section class="main__first">
        <p class="smart_tourism__platform">Smart Tourism Platform</p>
        <h1 class="main__first__heading" id="main__heading__discover">
          Discover. Experience
        </h1>
        <h1 class="main__first__heading">Belong.</h1>
        <p class="main__first__description">
          AI powered travel planning that boosts local economies &amp;
          unforgettable experience
        </p>
        <p class="main__first__search-inputs">
          <input
            type="text"
            id="main__first__search-text"
            class="main__first__search-item"
            placeholder="Where do you want to go?"
          />
          <input
            type="date"
            id="main__first__search-date"
            class="main__first__search-item"
            placeholder="Date"
          />
          <button
            id="main__first__search-button"
            class="main__first__search-item"
          >
            Search
          </button>
        </p>
      </section>
      <ul class="main__about__features">
        <li class="main__about__feature">
          <p class="main__about__feature-number">12,400+</p>
          <p class="main__about__feature-text">Hotels Listed</p>
        </li>
        <li class="main__about__feature">
          <p class="main__about__feature-number">840+</p>
          <p class="main__about__feature-text">Tour Packages</p>
        </li>
        <li class="main__about__feature">
          <p class="main__about__feature-number">2.1M</p>
          <p class="main__about__feature-text">Happy Travelers</p>
        </li>
        <li class="main__about__feature">
          <p class="main__about__feature-number">320+</p>
          <p class="main__about__feature-text">Local Guides</p>
        </li>
      </ul>
      <section class="main__destinations">
        <div class="main__destinations-header">
          <h2 class="main__destinations-header__head">Top Destinations</h2>
          <a href="#" class="main__destinations-header__a">view all ➡️</a>
        </div>
        <section class="main__top-destinations">
          <% for(let i=0;i<5;i++){ %>
            <article class="main__top-destination" id="<%=destination[i].id %>">
            <p class="main__top-destination-<%=destination[i].badges[0].toLowerCase().split(' ').join('')%>"><%=destination[i].badges[0] %></p>
            <section class="top-destination__img" style="background-image: url('destinations/<%=destination[i].image%>');"></section>
            <section class="top-destination__about">
              <p><%=destination[i].state %></p>
              <div class="top-destination__about-rating">
                <p><%=destination[i].totalPackages %> Packages</p>
                <p>⭐<%=destination[i].rating %> </p>
              </div>
            </section>
          </article>
            <% } %>
          
        </section>
      </section>

      <section class="main__featured-hotels">
        <section class="main__featured-hotels__header">
          <h2>Featured Hotels</h2>
          <a href="#">view all➡️</a>
        </section>
        <section class="main__featured-hotels__hotels">
          <% for(let i=0;i<4;i++){ %>
            <article class="main__featured-hotel" >
            <section class="main__featured-hotel__about">
              <div class="main__featured-hotel__about-img" style="background-image: url('hotels/<%= hotel[i].images[0] %>')"></div>
              <div class="main__featured-hotel__about-details">
                <p class="main__featured-hotel__about-details-name">
                  <%= hotel[i].name %>
                </p>
                <p class="main__featured-hotel__about-details-location">
                  <%= hotel[i].location.city %>, <%= hotel[i].location.state %>
                </p>
                <div class="main__featured-hotel__about-details__types">
                  <p id=<%= hotel[i].tags[0].toLowerCase().split(' ').join('') %>><%=hotel[i].tags[0] %></p>
                  <p><%=hotel[i].category %></p>
                  <p><%=hotel[i].stars %> stars</p>
                </div>
              </div>
            </section>
            <section class="main__featured-hotel__price">
              <p class="main__featured-hotel__price-rupees"><%=hotel[i].pricePerNight %></p>
              <p class="main__featured-hotel__price-pernight">per night</p>
            </section>
          </article>
            <% } %>
        </section>
      </section>
    </main>
    <footer>
      <p class="footer__details">
        WanderSmart boosts tourism by connecting travelers with local
        experiences, certified eco-stays, and community-first guides.
      </p>
      <button class="footer__button">Join the mission</button>
    </footer>
  </body>
</html>

<script>

  function getFormattedAmout(amt) {
    const formatted = new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amt);
    return formatted
  }

  const amount = document.querySelectorAll('.main__featured-hotel__price-rupees');
  const formattedAmt = Array.from(amount).map(el =>{
    const amt = parseInt(el.innerText);
    return getFormattedAmout(amt);
  })


  
  const rupee = document.querySelectorAll(
    ".main__featured-hotel__price-rupees",
  );
  rupee.forEach((el,idx) => (el.innerText = formattedAmt[idx]));

  const dialog = document.querySelector('dialog');
  const destinationEles = document.querySelectorAll('.main__top-destination')
  destinationEles.forEach(destinationEle => {
    destinationEle.addEventListener('click', async function(evt){
    //console.log(evt.currentTarget.id);
    const fetchedData = await fetch(`http://localhost:3000/destinations/${evt.currentTarget.id}`)
    const body = await fetchedData.json();
    const destination = JSON.parse(body.destination)[0];
    console.log(destination)
    const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December"
];

      let content = `<p>Select a Tab Button`
      
    dialog.innerHTML = `
    <header style="background-image:url(destinations/${destination.image})" class="destinationDialog__header destinationDialog__header-background-img">
            <div class="destinationDialog__header-menu">
              <div class="destinationDialog__header-tags">
                ${destination.badges.map(el => `<p id="${el.toLowerCase().split(' ').join('')}">${el}</p>`).join('')}
              </div>
              <form method="dialog" style="position:sticky;z-index:10;">
              <button class="closeModal" onclick="closeDialog()">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                </svg>
                </button>
              </form>
            </div>
          <div class="destinationDialog__header-head">
            <h1>${destination.name}, ${destination.state}</h1>
            <p><span>${destination.region}</span><span>${destination.totalPackages} Packages Available</span><span>${destination.rating}</span><span>${destination.totalReviews} reviews</span></p>
          </div>
          
        </header>
        <main class="destinationDialog__main">
            <div class="destinationDialog__main-desc">
              <p>${destination.tagline}.</p>
              <div class="destinationDialog__main-desc__rating">
                <p style="font-size:large">⭐${destination.rating}</p>
                <p style="font-size:x-small">${destination.totalReviews} reviews</p>
              </div>
            </div>
            <ul class="destinationDialog__main-tagslist">
              ${destination.categories.map(el => `<li class="destinationDialog__main-tagslist-item">${el}</li>`).join('')}
            </ul>
            <section class="destinationDialog__main-tabs">
              <ul class="destinationDialog__main-tabs-btns">
                <li class="destinationDialog__main-tabs-item"><button class="destinationDialog__main-tabs-btn" onclick="(() => {document.querySelector('.tabOverview').classList.add('active');document.querySelector('.tabItinerary').classList.remove('active');document.querySelector('.howToReach').classList.remove('active');})()">Overview</button></li>
                <li class="destinationDialog__main-tabs-item"><button class="destinationDialog__main-tabs-btn" onclick="(() => {document.querySelector('.tabItinerary').classList.add('active');document.querySelector('.tabOverview').classList.remove('active');document.querySelector('.howToReach').classList.remove('active');})()">Itineray Ideas</button></li>
                <li class="destinationDialog__main-tabs-item"><button class="destinationDialog__main-tabs-btn" onclick="(() => {document.querySelector('.howToReach').classList.add('active');document.querySelector('.tabOverview').classList.remove('active');document.querySelector('.tabItinerary').classList.remove('active');})()">How to reac</button></li>
              </ul>



              <div class="tabOverview">
              <div class="destinationDialog__main-tabs-topattractions">
                <p class="destinationDialog__main-tabs-topattractions-head">Top Attraction</p>
                  <ul class="destinationDialog__main-tabs-topattractions-list">
                  ${destination.topAttractions.map(el => `<li class="destinationDialog__main-tabs-topattraction">
                    <div class="topAttractionImage" style="background-image:url(topAttractions/${el.split(' ')[0].toLowerCase()}.jpg)">
                      <p class="topAttractionName">${el}</p>
                    </li>` ).join('')}
                      </div>
                </ul>
              

              <section class="dialog-overviewinfo">
                <div class="overview-quickinfo">
                  <h2 class="overview-quickinfo-head"><span>Quick Info</span></h2>
                  <p><span>State</span> <span>${destination.state}</span> </p>
                  <p><span>Region</span> <span>${destination.region}</span> </p>
                  <p><span>Summer</span> <span>${destination.weather.summer}</span> </p>
                  <p><span>Winter</span> <span>${destination.weather.winter.slice(0,27)}</span> </p>
                  <p><span>Packages</span> <span>${destination.totalPackages}</span> </p>
                  <p><span>Starting from</span> <span style="color:#42f54e;font-size:large">${getFormattedAmout(destination.startingPrice)}<span style="font-size:medium">/person</span></span>  </p>

                </div>
                <div class="overview-localcuisine">
                  <h2>Local Cuisine</h2>
                  <ul class="overview-localcuisine-tags">
                    ${destination.localCuisine.map(el => `<li class="overview-localcuisine-tag">${el}</li>`).join('')}
                  </ul>
                  <div class="overview-localcuisine-rating">
                    rating - x/y moderate sustainablity
                  </div>
                </div>
              </section>
            

            <section class="destinationDialogMonths">
              <p>Best Time to Visit</p>
              <ul>
                ${months.map(el => `<li class="${destination.bestTimeToVisit.includes(el) ? 'bestTimeToVisit' : '' }">${el.slice(0,3)}</li>`).join('')}
              </ul>
            </section>
            <section class="destinationDialogMonths">
              <p>Near By destinations</p>
              <ul>
                ${destination.nearbyDestinations.map(el => `<li>${el}</li>`).join('')}
              </ul>
            </section>
            
            </div>
            </div>


             <section class="tabItinerary">
        <ul class="ItineraryItems">
            <li class="ItineraryItem">
                <p>Day 1 — Arrival & Old City</p>
                <p>Check-in at hotel · Johari Bazaar · Hawa Mahal evening view · Local dinner</p>
            </li>
            <li class="ItineraryItem">
                <p>Day 1 — Arrival & Old City</p>
                <p>Check-in at hotel · Johari Bazaar · Hawa Mahal evening view · Local dinner</p>
            </li>
            <li class="ItineraryItem">
                <p>Day 1 — Arrival & Old City</p>
                <p>Check-in at hotel · Johari Bazaar · Hawa Mahal evening view · Local dinner</p>
            </li>
            <li class="ItineraryItem ItineraryItem-btn">
                <button class="ItineraryItemBtn">Generate Full custom Itineray</button>
            </li>
        </ul>
    </section>

    <section class="howToReach">
      <ul class="howToReachItems">
        
        <li class="howToReachItem">
          <div class="reachBy-"></div>
          <div class="reachByDesc">
            <p>BY AIR</p>
            <p>
              ${destination.howToReach.byAir}
            </p>
          </div>
        </li>
        <li class="howToReachItem">
          <div class="reachBy-"></div>
          <div class="reachByDesc">
            <p>BY TRAIN</p>
            <p>
              ${destination.howToReach.byTrain}
            </p>
          </div>
        </li>
        <li class="howToReachItem">
          <div class="reachBy-"></div>
          <div class="reachByDesc">
            <p>BY ROAD</p>
            <p>
              ${destination.howToReach.byRoad}
            </p>
          </div>
        </li>
      </ul>
    </section>
            
            
          </main>
          <footer class="destinationDialog__footer">
            <div class="destinationDialog__footer-price">
              <p style="font-size: medium;">Starting From</p>
              <p><span style="font-size:x-large;color: #42f54e;">${getFormattedAmout(destination.startingPrice)}</span><span>/person</span></p>
              <p style="font-size: medium;" >${destination.totalPackages} packages available</p>
            </div>
            <menu class="destinationDialog__footer-menu">
              <button>View Hotels</button>
              <button>Browse Packages</button>
            </menu>
          </footer>
    `
    document.body.style.overflow = "hidden"; 
    dialog.showModal();
  })
  })

  function closeDialog(){
         document.body.style.overflow = ""; 
    }
 
</script>
