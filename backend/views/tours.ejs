<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/1865/1865269.png">
    <title>Tours — WanderSmart</title>
    <link rel="stylesheet" href="tours.css" />
    <link rel="stylesheet" href="/nav-auth.css">
    <link rel="stylesheet" href="/theme.css">
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <script src="/theme.js"></script>
  </head>
  <body>
    <!-- ── Navbar ──────────────────────────────────────────────────── -->
     <header>
      <div id="navbar">
        <h1 class="navbar-logo">
          <a style="text-decoration: none" href="/"
            ><span style="color: white">Wander</span
            ><span style="color: rgb(6, 187, 6)">Smart</span></a
          >
        </h1>
        <button class="navbar__toggle" id="navbar-toggle" aria-label="Toggle navigation">
    <span class="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>
        <ul class="nav__items" id="nav-items">
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/explore">Explore</a></li>
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/hotels">Hotels</a></li>
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/tours">Tours</a></li>
          <li class="nav__item" id="nav-dashboard"><a style="text-decoration: none; color: inherit;" href="/Dashboard">Dashboard</a></li>
          <li class="nav__item" id="nav-logout"><span style="text-decoration: none; color: inherit;">Logout</span></li>
          <li class="theme-toggle-item">
            <button class="theme-toggle-btn" id="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">☀️</button>
          </li>
          <div id="nav-auth-slot"></div>
        </ul>
        <!-- <div class="nav__item-ctx"> -->
          
        <!-- </div> -->
      </div>
    </header>

    <!-- ── Page header ─────────────────────────────────────────────── -->
    <div class="page-hero">
      <h1 class="page-title">Tour Packages</h1>
      <p class="page-sub">
        Curated experiences with certified local guides — supporting
        communities, not just sightseeing
      </p>
      <div class="cat-chips" id="cat-chips">
        <button class="chip active" data-cat="all">All</button>
        <button class="chip" data-cat="Adventure">Adventure</button>
        <button class="chip" data-cat="Culture">Culture</button>
        <button class="chip" data-cat="Wildlife">Wildlife</button>
        <button class="chip" data-cat="Beach">Beach</button>
        <button class="chip" data-cat="Spiritual">Spiritual</button>
        <button class="chip" data-cat="Budget">Budget</button>
        <button class="chip" data-cat="Luxury">Luxury</button>
        <button class="chip" data-cat="Family">Family</button>
      </div>
    </div>

    <!-- ── States ──────────────────────────────────────────────────── -->
    <div id="loading-state" class="state-box">Loading tour packages...</div>
    <div id="error-state" class="state-box error" style="display: none">
      Failed to load tours. Please try again.
    </div>

    <!-- ── Tour grid ───────────────────────────────────────────────── -->
    <div class="tour-grid" id="tour-grid"></div>

    <!-- ── Guides section ──────────────────────────────────────────── -->
    <div class="guides-section" id="guides-section" style="display: none">
      <div class="guides-label">MEET OUR LOCAL GUIDES</div>
      <div class="guides-row" id="guides-row"></div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
     BOOKING DIALOG
═══════════════════════════════════════════════════════════════ -->
    <div class="dialog-backdrop" id="dialog-backdrop" style="display: none">
      <div class="dialog" id="dialog">
        <!-- Step indicator -->
        <div class="dialog-steps">
          <div class="step active" id="step-ind-1">
            <span class="step-num">1</span
            ><span class="step-lbl">Your details</span>
          </div>
          <div class="step-line"></div>
          <div class="step" id="step-ind-2">
            <span class="step-num">2</span><span class="step-lbl">Payment</span>
          </div>
        </div>

        <!-- ── Step 1: Client details ──────────────────────────────── -->
        <div id="step-1">
          <div class="dialog-header">
            <div>
              <div class="dialog-title" id="dialog-tour-name">Tour Name</div>
              <div class="dialog-sub" id="dialog-tour-meta">
                5 Days · ₹12,800 per person
              </div>
            </div>
            <button class="dialog-close" id="dialog-close">✕</button>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label"
                >Full name <span class="req">*</span></label
              >
              <input
                type="text"
                id="f-name"
                class="form-input"
                placeholder="e.g. Arjun Sharma"
              />
            </div>
            <div class="form-group">
              <label class="form-label"
                >Email address <span class="req">*</span></label
              >
              <input
                type="email"
                id="f-email"
                class="form-input"
                placeholder="you@example.com"
              />
            </div>
            <div class="form-group">
              <label class="form-label"
                >Phone number <span class="req">*</span></label
              >
              <input
                type="tel"
                id="f-phone"
                class="form-input"
                placeholder="+91 98765 43210"
              />
            </div>
            <div class="form-group">
              <label class="form-label"
                >Number of travellers <span class="req">*</span></label
              >
              <select id="f-travellers" class="form-input">
                <option value="">Select</option>
                <option value="1">1 person</option>
                <option value="2">2 people</option>
                <option value="3">3 people</option>
                <option value="4">4 people</option>
                <option value="5+">5+ people</option>
              </select>
            </div>
            <div class="form-group full">
              <label class="form-label"
                >Travel date <span class="req">*</span></label
              >
              <input type="date" id="f-date" class="form-input" />
            </div>
            <div class="form-group full">
              <label class="form-label"
                >Special requests
                <span class="form-optional">(optional)</span></label
              >
              <textarea
                id="f-notes"
                class="form-input form-textarea"
                placeholder="Dietary needs, accessibility, preferences..."
              ></textarea>
            </div>
          </div>

          <div class="dialog-footer">
            <div class="total-preview" id="total-preview">Total: ₹12,800</div>
            <button class="btn-next" id="btn-next">Next — Payment →</button>
          </div>
        </div>

        <!-- ── Step 2: Payment ─────────────────────────────────────── -->
        <div id="step-2" style="display: none">
          <div class="dialog-header">
            <div>
              <div class="dialog-title">Payment details</div>
              <div class="dialog-sub" id="pay-summary">
                Himalayan Expedition · 2 people · ₹37,000
              </div>
            </div>
            <button class="dialog-close" id="dialog-close-2">✕</button>
          </div>

          <div class="pay-methods">
            <button class="pay-method active" data-method="card">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <rect
                  x="1"
                  y="3"
                  width="16"
                  height="12"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
                <path d="M1 7h16" stroke="currentColor" stroke-width="1.4" />
                <rect
                  x="3"
                  y="10"
                  width="4"
                  height="2"
                  rx="1"
                  fill="currentColor"
                />
              </svg>
              Credit / Debit Card
            </button>
            <button class="pay-method" data-method="upi">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path
                  d="M9 2L3 9l6 7 6-7-6-7z"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linejoin="round"
                />
              </svg>
              UPI
            </button>
            <button class="pay-method" data-method="netbanking">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path
                  d="M2 14h14M9 4v10M3 8l6-4 6 4"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Net Banking
            </button>
          </div>

          <!-- Card form -->
          <div id="pay-card-form" class="form-grid">
            <div class="form-group full">
              <label class="form-label"
                >Name on card <span class="req">*</span></label
              >
              <input
                type="text"
                id="p-cardname"
                class="form-input"
                placeholder="As printed on card"
              />
            </div>
            <div class="form-group full">
              <label class="form-label"
                >Card number <span class="req">*</span></label
              >
              <input
                type="text"
                id="p-cardnum"
                class="form-input"
                placeholder="1234  5678  9012  3456"
                maxlength="19"
              />
            </div>
            <div class="form-group">
              <label class="form-label"
                >Expiry <span class="req">*</span></label
              >
              <input
                type="text"
                id="p-expiry"
                class="form-input"
                placeholder="MM / YY"
                maxlength="7"
              />
            </div>
            <div class="form-group">
              <label class="form-label">CVV <span class="req">*</span></label>
              <input
                type="text"
                id="p-cvv"
                class="form-input"
                placeholder="•••"
                maxlength="4"
              />
            </div>
          </div>

          <!-- UPI form -->
          <div id="pay-upi-form" class="form-grid" style="display: none">
            <div class="form-group full">
              <label class="form-label"
                >UPI ID <span class="req">*</span></label
              >
              <input
                type="text"
                id="p-upi"
                class="form-input"
                placeholder="yourname@upi"
              />
            </div>
          </div>

          <!-- Net banking form -->
          <div id="pay-net-form" class="form-grid" style="display: none">
            <div class="form-group full">
              <label class="form-label"
                >Select bank <span class="req">*</span></label
              >
              <select id="p-bank" class="form-input">
                <option value="">Choose your bank</option>
                <option>SBI</option>
                <option>HDFC Bank</option>
                <option>ICICI Bank</option>
                <option>Axis Bank</option>
                <option>Kotak Bank</option>
                <option>PNB</option>
              </select>
            </div>
          </div>

          <div class="secure-note">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path
                d="M7 1L2 3v4c0 2.76 2.13 5.34 5 6 2.87-.66 5-3.24 5-6V3L7 1z"
                stroke="#1D9E75"
                stroke-width="1.2"
              />
            </svg>
            256-bit SSL encrypted · Your payment info is never stored
          </div>

          <div class="dialog-footer">
            <button class="btn-back" id="btn-back">← Back</button>
            <button class="btn-pay" id="btn-pay">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M13 5H3a1 1 0 00-1 1v6a1 1 0 001 1h10a1 1 0 001-1V6a1 1 0 00-1-1z"
                  stroke="currentColor"
                  stroke-width="1.3"
                />
                <path
                  d="M10 5V3a2 2 0 10-4 0v2"
                  stroke="currentColor"
                  stroke-width="1.3"
                />
              </svg>
              Confirm &amp; Pay <span id="pay-btn-amt"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Loading overlay ─────────────────────────────────────────── -->
    <div class="loading-overlay" id="loading-overlay" style="display: none">
      <div class="spinner"></div>
      <div class="loading-text">Processing your booking...</div>
    </div>

    <!-- ── Success popup ───────────────────────────────────────────── -->
    <div class="success-overlay" id="success-overlay" style="display: none">
      <div class="success-box">
        <div class="success-tick">
          <svg
            viewBox="0 0 52 52"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle cx="26" cy="26" r="25" stroke="#1D9E75" stroke-width="2" />
            <path
              class="tick-path"
              d="M14 26 L22 34 L38 18"
              stroke="#1D9E75"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
        <div class="success-title">Tour Booked!</div>
        <div class="success-msg" id="success-msg">
          Your adventure is confirmed. Check your email for details.
        </div>
        <div class="success-ref">
          Booking ID: <strong id="booking-ref"></strong>
        </div>
        <button class="btn-done" id="btn-done">Done</button>
      </div>
    </div>

    <!-- ── Error popup ─────────────────────────────────────────────── -->
    <div class="error-popup" id="error-popup" style="display: none">
      <div class="error-popup-inner">
        <div class="error-icon">!</div>
        <div class="error-popup-msg" id="error-popup-msg">
          You missed something...
        </div>
        <button class="btn-dismiss" id="btn-dismiss">Fix it</button>
      </div>
    </div>
  </body>
</html>

<script src="/auth.js"></script>

<script src="/tours.js">

</script>
