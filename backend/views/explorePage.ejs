<script>
  const map = new maptilersdk.Map({
    container: "map",
    style: `https://api.maptiler.com/maps/streets/style.json?key=P2YnxuVUfPXTTg1SJKHA`,
    center: [78.9629, 20.5937],
    zoom: 5,
  });
    const API = window.location.hostname === "localhost"
  ? "http://localhost:3000"
  : "https://college-project-int222.onrender.com";
  async function loadDestinations() {
    const res = await fetch(`${API}/explore/filter/a`);
    const data = await res.json();
    const destinations = JSON.parse(data.destinations);
    destinations.forEach((dest) => {
      // Add marker
      new maptilersdk.Marker()
        .setLngLat([dest.lng, dest.lat]) // IMPORTANT: [lng, lat]
        .addTo(map);
    });

  }
  loadDestinations();
</script>

<script>
  async function getDestinations(id) {
    const fetchedData = await fetch(
      `${API}/explore/filter/${id}`,
    );
    const body = await fetchedData.json();
    let destinationsArray = JSON.parse(body.destinations);
    const filteredDestinationsArray = JSON.parse(body.filteredDestinations);
    const destinationSection = document.querySelector(".main__destinations");
    if (filteredDestinationsArray.length) {
      destinationsArray = filteredDestinationsArray;
    }
    destinationSection.innerHTML = destinationsArray
      .map(
        (el) => `
     <article id=${el.id} class="main__top-destination">
           <p class="main__destination-rating-package">${el.rating}💠${el.totalPackages} packages</p>
           <section class="top-destination__img" style="background-image:url('/destinations/${el.image}')"></section>
           <section class="top-destination__about">
             <p>${el.name}, ${el.state}</p>
             <div class="top-destination__about-rating">
               <p style="color:rgba(255,255,255,.4);font-Size:small">${el.badges[0]}💠${el.badges[1].split(" ")[0]}</p>
               <p>⭐${el.rating}</p>
             </div>
           </section>
         </article>
     `,
      )
      .join("");
  }
  function getFormattedAmout(amt) {
    const formatted = new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(amt);
    return formatted;
  }

