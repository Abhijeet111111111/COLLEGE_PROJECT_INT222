  const main_destinations = document.querySelector(".main__destinations");
  const searchInput = document.querySelector(".main__filter-search");
  let timeout;
  searchInput.addEventListener("input", (evt) => {
    clearTimeout(timeout);

    timeout = setTimeout(async () => {
      const query = searchInput.value.trim();

      if (!query) {
        const para = document.createElement("p");
        para.innerText = "No results found";
        para.style = "text-align:center;color:white";
        main_destinations.innerHTML = "";
        main_destinations.appendChild(para);
        return;
      }
