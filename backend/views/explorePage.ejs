<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="180x180" href="https://cdn-icons-png.flaticon.com/512/5776/5776740.png">
    <title>Explore Destinations</title>
    <link rel="stylesheet" href="explorePage.css" />
    <link rel="stylesheet" href="/nav-auth.css">
    <link rel="stylesheet" href="/theme.css">
    <link
      href="https://api.maptiler.com/maps/streets/style.css?key=P2YnxuVUfPXTTg1SJKHA"
      rel="stylesheet"
    />
    <script src="/theme.js"></script>
    <script src="https://cdn.maptiler.com/maptiler-sdk-js/v2.0.0/maptiler-sdk.umd.min.js"></script>
  </head>
  <body>
    
      <div id="navbar">
        <h1 class="navbar-logo">
          <a style="text-decoration: none" href="/"
            ><span style="color: white">Wander</span
            ><span style="color: rgb(6, 187, 6)">Smart</span></a
          >
        </h1>
        <button class="navbar__toggle" id="navbar-toggle" aria-label="Toggle navigation">
    <span class="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>
        <ul class="nav__items" id="nav-items">
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/explore">Explore</a></li>
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/hotels">Hotels</a></li>
          <li class="nav__item"><a style="text-decoration: none; color: inherit;" href="/tours">Tours</a></li>
          <li class="nav__item" id="nav-dashboard"><a style="text-decoration: none; color: inherit;" href="/Dashboard">Dashboard</a></li>
          <li class="nav__item" id="nav-logout"><span style="text-decoration: none; color: inherit;">Logout</span></li>
          <li class="theme-toggle-item">
            <button class="theme-toggle-btn" id="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">☀️</button>
          </li>
          <div id="nav-auth-slot"></div>
        </ul>
        <!-- <div class="nav__item-ctx"> -->
          
        <!-- </div> -->
      </div>
    
    <main>
      <dialog id="destinationDialog"></dialog>
      <section class="main__header">
        <h1 class="main__header-head">Explore Destinations</h1>
        <p class="main__header-desc">
          340 destinations across India — find your next adventure
        </p>
      </section>
      <section class="main__filter">
        <input
          type="text"
          id=""
          class="main__filter-search"
          placeholder="Search destinations"
        />
        <button
          class="main__filter-btn"
          id="all-destinations__filter"
          onclick="getDestinations('all')"
        >
          All
        </button>
        <button class="main__filter-btn" onclick="getDestinations('adventure')">
          Adventure
        </button>
        <button class="main__filter-btn" onclick="getDestinations('culture')">
          Culture
        </button>
        <button class="main__filter-btn" onclick="getDestinations('beach')">
          Beach
        </button>
        <button class="main__filter-btn" onclick="getDestinations('hills')">
          Hills
        </button>
        <button class="main__filter-btn" onclick="getDestinations('wildlife')">
          Wildlife
        </button>
        <button class="main__filter-btn" onclick="getDestinations('budget')">
          Budget
        </button>
      </section>
      <section class="main__map">
        <p class="main__map-head">Destination Map</p>
        <div class="main__map-map">
          <div id="map" style="height: 100%; width: 100%"></div>
        </div>
      </section>
      <section class="main__destinations"></section>
    </main>
  </body>
</html>

<script src="/auth.js"></script>


<script src="/explorePage.js">


</script>
