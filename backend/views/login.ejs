<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — WanderSmart</title>
    <link rel="stylesheet" href="login.css" />
    <link rel="stylesheet" href="/theme.css">
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <script src="/theme.js"></script>
  </head>
  <body>
    <!-- ── Navbar (minimal) ────────────────────────────────────── -->
    <nav class="navbar">
      <a class="nav-logo" href="/">Wander<span>Smart</span></a>
      <div style="margin-left:auto; display:flex; align-items:center; gap:12px;">
        <button class="theme-toggle-btn" id="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme">☀️</button>
        <div id="nav-auth-slot"></div>
      </div>
    </nav>

    <!-- ── Page layout ─────────────────────────────────────────── -->
    <div class="auth-page">
      <!-- Left decorative panel -->
      <div class="auth-panel">
        <div class="panel-content">
          <div class="panel-tagline">Your next adventure<br />starts here.</div>
          <div class="panel-sub">
            Book hotels, curated tours, and local experiences across India — all
            in one place.
          </div>
          <div class="panel-stats">
            <div class="pstat">
              <div class="pstat-num">12,400+</div>
              <div class="pstat-lbl">Hotels</div>
            </div>
            <div class="pstat">
              <div class="pstat-num">840+</div>
              <div class="pstat-lbl">Tour packages</div>
            </div>
            <div class="pstat">
              <div class="pstat-num">2.1M</div>
              <div class="pstat-lbl">Happy travellers</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right form panel -->
      <div class="auth-form-panel">
        <div class="auth-card">
          <!-- Tab switcher -->
          <div class="auth-tabs">
            <button
              class="auth-tab active"
              id="tab-login"
              onclick="switchTab('login')"
            >
              Log in
            </button>
            <button
              class="auth-tab"
              id="tab-signup"
              onclick="switchTab('signup')"
            >
              Sign up
            </button>
          </div>

          <!-- ── LOGIN FORM ─────────────────────────────────────── -->
          <div id="form-login">
            <div class="auth-welcome">Welcome back</div>
            <div class="auth-sub">Log in to continue planning your trip</div>

            <div class="form-field">
              <label class="form-label">Email address</label>
              <input
                id="l-email"
                class="form-input"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
              />
            </div>
            <div class="form-field">
              <label class="form-label">Password</label>
              <div class="input-wrap">
                <input
                  id="l-password"
                  class="form-input"
                  type="password"
                  placeholder="Your password"
                  autocomplete="current-password"
                />
                <button
                  class="toggle-pw"
                  type="button"
                  onclick="togglePw('l-password', this)"
                >
                  <svg
                    id="eye-l"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                  >
                    <path
                      d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                    <circle
                      cx="8"
                      cy="8"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                  </svg>
                </button>
              </div>
            </div>
            <div class="forgot-row">
              <a class="forgot-link" href="/users/forgotPassword">Forgot password?</a>
            </div>

            <div class="auth-error" id="l-error" style="display: none"></div>

            <button class="btn-auth" id="btn-login" onclick="handleLogin()">
              <span id="l-btn-text">Log in</span>
              <div
                class="btn-spinner"
                id="l-spinner"
                style="display: none"
              ></div>
            </button>

            <div class="auth-switch">
              Don't have an account?
              <a onclick="switchTab('signup')">Sign up free</a>
            </div>
          </div>

          <!-- ── SIGNUP FORM ─────────────────────────────────────── -->
          <div id="form-signup" style="display: none">
            <div class="auth-welcome">Create your account</div>
            <div class="auth-sub">
              Join 2.1 million travellers on WanderSmart
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label class="form-label"
                  >Full name <span class="req">*</span></label
                >
                <input
                  id="s-name"
                  class="form-input"
                  type="text"
                  placeholder="Arjun Sharma"
                  autocomplete="name"
                />
              </div>
              <div class="form-field">
                <label class="form-label">Phone number</label>
                <input
                  id="s-phone"
                  class="form-input"
                  type="tel"
                  placeholder="+91 98765 43210"
                  autocomplete="tel"
                />
              </div>
            </div>
            <div class="form-field">
              <label class="form-label"
                >Email address <span class="req">*</span></label
              >
              <input
                id="s-email"
                class="form-input"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
              />
            </div>
            <div class="form-field">
              <label class="form-label"
                >Password <span class="req">*</span></label
              >
              <div class="input-wrap">
                <input
                  id="s-password"
                  class="form-input"
                  type="password"
                  placeholder="Min 8 characters"
                  autocomplete="new-password"
                />
                <button
                  class="toggle-pw"
                  type="button"
                  onclick="togglePw('s-password', this)"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                    <circle
                      cx="8"
                      cy="8"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                  </svg>
                </button>
              </div>
              <div class="pw-strength" id="pw-strength" style="display: none">
                <div class="pw-bar" id="pw-bar"></div>
                <span id="pw-label"></span>
              </div>
            </div>
            <div class="form-field">
              <label class="form-label"
                >Confirm password <span class="req">*</span></label
              >
              <div class="input-wrap">
                <input
                  id="s-confirm"
                  class="form-input"
                  type="password"
                  placeholder="Repeat password"
                  autocomplete="new-password"
                />
              </div>
            </div>

            <div class="terms-row">
              <input type="checkbox" id="s-terms" class="terms-check" />
              <label for="s-terms"
                >I agree to the <a href="#">Terms of Service</a> and
                <a href="#">Privacy Policy</a></label
              >
            </div>

            <div class="auth-error" id="s-error" style="display: none"></div>

            <button class="btn-auth" id="btn-signup" onclick="handleSignup()">
              <span id="s-btn-text">Create account</span>
              <div
                class="btn-spinner"
                id="s-spinner"
                style="display: none"
              ></div>
            </button>

            <div class="auth-switch">
              Already have an account?
              <a onclick="switchTab('login')">Log in</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/auth.js"></script>
    <script src="/login.js">
     
    </script>
  </body>
</html>
