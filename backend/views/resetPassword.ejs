<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — WanderSmart</title>
    <link rel="stylesheet" href="/login.css" />
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ── Page-specific extras ──────────────────────────────────── */

      .card-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--green-dim);
        border: 1px solid #1a4d35;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
      }

      /* Password strength bar */
      .pw-strength {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        margin-bottom: 2px;
      }
      .pw-track {
        flex: 1;
        height: 4px;
        background: var(--border);
        border-radius: 4px;
        overflow: hidden;
      }
      .pw-fill {
        height: 100%;
        width: 0%;
        border-radius: 4px;
        transition:
          width 0.3s ease,
          background 0.3s ease;
      }
      .pw-label {
        font-size: 11px;
        font-weight: 500;
        min-width: 40px;
        text-align: right;
      }

      /* Password rules checklist */
      .pw-rules {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 10px;
        margin-bottom: 4px;
      }
      .pw-rule {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: var(--text-hint);
        transition: color 0.2s;
      }
      .pw-rule.met {
        color: var(--green-txt);
      }
      .pw-rule-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 1.5px solid currentColor;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition:
          border-color 0.2s,
          background 0.2s;
      }
      .pw-rule.met .pw-rule-dot {
        background: var(--green);
        border-color: var(--green);
      }
      .pw-rule-dot svg {
        display: none;
      }
      .pw-rule.met .pw-rule-dot svg {
        display: block;
      }

      /* Match indicator under confirm field */
      .match-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 7px;
        font-size: 12px;
        color: var(--text-hint);
        min-height: 18px;
      }
      .match-indicator.match {
        color: var(--green-txt);
      }
      .match-indicator.no-match {
        color: #f09595;
      }

      /* ── SUCCESS screen ──────────────────────────────────────── */
      .reset-success {
        text-align: center;
        padding: 8px 0 4px;
      }
      .success-ring {
        width: 72px;
        height: 72px;
        margin: 0 auto 22px;
      }
      .ring-track {
        stroke-dasharray: 220;
        stroke-dashoffset: 220;
        animation: ringDraw 0.6s ease 0.1s forwards;
      }
      .ring-check {
        stroke-dasharray: 40;
        stroke-dashoffset: 40;
        animation: checkDraw 0.4s ease 0.65s forwards;
      }
      @keyframes ringDraw {
        to {
          stroke-dashoffset: 0;
        }
      }
      @keyframes checkDraw {
        to {
          stroke-dashoffset: 0;
        }
      }

      .reset-success-title {
        font-size: 22px;
        font-weight: 500;
        margin-bottom: 8px;
      }
      .reset-success-sub {
        font-size: 13px;
        color: var(--text-sec);
        line-height: 1.7;
        margin-bottom: 26px;
      }
      .redirect-bar {
        font-size: 12px;
        color: var(--text-hint);
        margin-top: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .redirect-progress {
        flex: 1;
        max-width: 80px;
        height: 2px;
        background: var(--border);
        border-radius: 2px;
        overflow: hidden;
      }
      .redirect-fill {
        height: 100%;
        background: var(--green);
        width: 0%;
        transition: width 0.1s linear;
      }

      /* ── INVALID TOKEN screen ───────────────────────────────── */
      .token-invalid {
        text-align: center;
        padding: 8px 0 4px;
      }
      .invalid-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--red-dim);
        border: 1px solid var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: #f09595;
        font-size: 28px;
        font-weight: 700;
      }
      .invalid-title {
        font-size: 20px;
        font-weight: 500;
        margin-bottom: 8px;
      }
      .invalid-sub {
        font-size: 13px;
        color: var(--text-sec);
        line-height: 1.7;
        margin-bottom: 24px;
      }

      /* Back link */
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--text-sec);
        margin-bottom: 28px;
        transition: color 0.18s;
      }
      .back-link:hover {
        color: var(--text);
      }
    </style>
  </head>
  <body>
    <!-- ── Navbar ──────────────────────────────────────────────────── -->
    <nav class="navbar">
      <a class="nav-logo" href="/">Wander<span>Smart</span></a>
      <button class="theme-toggle-btn" id="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme" style="margin-left:auto;">☀️</button>
    </nav>

    <!-- ── Page layout ─────────────────────────────────────────────── -->
    <div class="auth-page">
      <!-- Left decorative panel -->
      <div class="auth-panel">
        <div class="panel-content">
          <div class="panel-tagline">
            Almost there —<br />set a new<br />password.
          </div>
          <div class="panel-sub">
            Choose a strong password you haven't used before. Once reset, you'll
            be taken straight to the login page.
          </div>
          <div class="panel-stats">
            <div class="pstat">
              <div class="pstat-num">8+ chars</div>
              <div class="pstat-lbl">Minimum length</div>
            </div>
            <div class="pstat">
              <div class="pstat-num">1-click</div>
              <div class="pstat-lbl">Instant login</div>
            </div>
            <div class="pstat">
              <div class="pstat-num">256-bit</div>
              <div class="pstat-lbl">Encryption</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right form panel -->
      <div class="auth-form-panel">
        <div class="auth-card">
          <!-- ── State: checking token (brief flicker prevention) ── -->
          <div id="state-loading">
            <div
              style="
                text-align: center;
                padding: 40px 0;
                color: var(--text-sec);
                font-size: 14px;
              "
            >
              Verifying your link...
            </div>
          </div>

          <!-- ── State: invalid / expired token ────────────────── -->
          <div id="state-invalid" style="display: none">
            <div class="token-invalid">
              <div class="invalid-icon">!</div>
              <div class="invalid-title">Link expired or invalid</div>
              <div class="invalid-sub">
                This password reset link has expired or has already been
                used.<br />
                Reset links are only valid for <strong>10 minutes</strong>.
              </div>
              <a
                href="users/forgotpassword"
                class="btn-auth"
                style="display: inline-flex; text-decoration: none"
              >
                Request a new link
              </a>
              <div class="auth-switch" style="margin-top: 14px">
                <a href="/login">Back to log in</a>
              </div>
            </div>
          </div>

          <!-- ── State: reset form ─────────────────────────────── -->
          <div id="state-form" style="display: none">
            <a class="back-link" href="/login">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path
                  d="M9 2L4 7l5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Back to log in
            </a>

            <div class="card-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect
                  x="3"
                  y="11"
                  width="18"
                  height="11"
                  rx="2"
                  stroke="#1D9E75"
                  stroke-width="1.6"
                />
                <path
                  d="M7 11V7a5 5 0 0110 0v4"
                  stroke="#1D9E75"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
                <circle cx="12" cy="16" r="1.5" fill="#5DCAA5" />
              </svg>
            </div>

            <div class="auth-welcome">Set a new password</div>
            <div class="auth-sub">
              Your new password must be different from any previously used
              password.
            </div>

            <!-- New password -->
            <div class="form-field">
              <label class="form-label" for="rp-new"
                >New password <span class="req">*</span></label
              >
              <div class="input-wrap">
                <input
                  id="rp-new"
                  class="form-input"
                  type="password"
                  placeholder="At least 8 characters"
                  autocomplete="new-password"
                  autofocus
                  oninput="onPasswordInput(this.value)"
                />
                <button
                  class="toggle-pw"
                  type="button"
                  onclick="togglePw('rp-new')"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                    <circle
                      cx="8"
                      cy="8"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                  </svg>
                </button>
              </div>

              <!-- Strength bar -->
              <div class="pw-strength" id="pw-strength" style="display: none">
                <div class="pw-track">
                  <div class="pw-fill" id="pw-fill"></div>
                </div>
                <span class="pw-label" id="pw-label"></span>
              </div>

              <!-- Rules checklist -->
              <div class="pw-rules">
                <div class="pw-rule" id="rule-length">
                  <div class="pw-rule-dot">
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path
                        d="M1.5 4l2 2 3-3"
                        stroke="#fff"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  At least 8 characters
                </div>
                <div class="pw-rule" id="rule-upper">
                  <div class="pw-rule-dot">
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path
                        d="M1.5 4l2 2 3-3"
                        stroke="#fff"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  One uppercase letter
                </div>
                <div class="pw-rule" id="rule-number">
                  <div class="pw-rule-dot">
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path
                        d="M1.5 4l2 2 3-3"
                        stroke="#fff"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  One number
                </div>
                <div class="pw-rule" id="rule-special">
                  <div class="pw-rule-dot">
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path
                        d="M1.5 4l2 2 3-3"
                        stroke="#fff"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  One special character (!@#$…)
                </div>
              </div>
            </div>

            <!-- Confirm password -->
            <div class="form-field">
              <label class="form-label" for="rp-confirm"
                >Confirm new password <span class="req">*</span></label
              >
              <div class="input-wrap">
                <input
                  id="rp-confirm"
                  class="form-input"
                  type="password"
                  placeholder="Repeat your new password"
                  autocomplete="new-password"
                  oninput="onConfirmInput(this.value)"
                />
                <button
                  class="toggle-pw"
                  type="button"
                  onclick="togglePw('rp-confirm')"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                    <circle
                      cx="8"
                      cy="8"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                  </svg>
                </button>
              </div>
              <div class="match-indicator" id="match-indicator"></div>
            </div>

            <div class="auth-error" id="rp-error" style="display: none"></div>

            <button class="btn-auth" id="btn-reset" onclick="handleReset()">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <rect
                  x="2"
                  y="7"
                  width="12"
                  height="8"
                  rx="1.5"
                  stroke="currentColor"
                  stroke-width="1.3"
                />
                <path
                  d="M5 7V5a3 3 0 016 0v2"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                />
              </svg>
              <span id="reset-txt">Reset password</span>
              <div
                class="btn-spinner"
                id="reset-spin"
                style="display: none"
              ></div>
            </button>
          </div>

          <!-- ── State: success ─────────────────────────────────── -->
          <div id="state-success" style="display: none">
            <div class="reset-success">
              <div class="success-ring">
                <svg
                  viewBox="0 0 72 72"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  width="72"
                  height="72"
                >
                  <circle
                    cx="36"
                    cy="36"
                    r="33"
                    stroke="#1a4d35"
                    stroke-width="3"
                  />
                  <circle
                    class="ring-track"
                    cx="36"
                    cy="36"
                    r="33"
                    stroke="#1D9E75"
                    stroke-width="3"
                    stroke-linecap="round"
                    transform="rotate(-90 36 36)"
                  />
                  <path
                    class="ring-check"
                    d="M20 36l10 10 22-20"
                    stroke="#1D9E75"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div class="reset-success-title">Password reset!</div>
              <div class="reset-success-sub">
                Your password has been updated successfully.<br />
                You can now log in with your new password.
              </div>

              <button class="btn-auth" id="btn-go-login" onclick="goToLogin()">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M10 8H2m0 0l3-3M2 8l3 3"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M7 2h7v12H7"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                Go to login
              </button>

              <div class="redirect-bar">
                <span>Redirecting automatically</span>
                <div class="redirect-progress">
                  <div class="redirect-fill" id="redirect-fill"></div>
                </div>
                <span id="redirect-count">3s</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/resetPassword.js">
     
    </script>
  </body>
</html>
